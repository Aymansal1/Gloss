<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only what shows before Compose draws: the ground colour, so launch doesn't flash. -->
    <style name="Theme.Gloss" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/gloss_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
